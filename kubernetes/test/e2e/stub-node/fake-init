#!/bin/bash
# Fake init for the e2e stub node — stands in for /lib/systemd/systemd.
#
# node-bootstrap.sh (generated by the operator, run verbatim) ends with
#   exec /lib/systemd/systemd --system --unit=multi-user.target
# so this process is what keeps the pod alive.
#
# It also serves a TCP listener on :22. The operator's cluster-join.sh waits for
# `nc -z <node-0> 22` before invoking pvecm add, mirroring how a real pvecm add
# exchanges cluster credentials over SSH. Without something accepting on 22 the
# join step correctly declines to run, so the stub provides a minimal listener.
# It speaks just enough to look like a reachable port; no SSH protocol is
# implemented, and none is needed because the stub pvecm never dials out.

set -u

log() { echo "[fake-init/$(hostname -s 2>/dev/null || hostname)] $*"; }

# Accept and immediately close connections on :22, forever.
listen_22() {
  while true; do
    # -l listen, -k keep accepting after each connection closes.
    if nc -l -k -p 22 >/dev/null 2>&1; then
      :
    else
      # Some netcat builds want -p omitted for listen mode.
      nc -l -k 22 >/dev/null 2>&1 || sleep 1
    fi
  done
}

listen_22 &
LISTENER_PID=$!
log "port 22 listener started (pid ${LISTENER_PID})"

# Reap the listener on termination so the pod stops promptly.
trap 'kill "${LISTENER_PID}" 2>/dev/null; exit 0' TERM INT

log "stub node up; sleeping as PID 1 stand-in"
while true; do
  sleep 3600 &
  wait $!
done
