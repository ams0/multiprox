##############################################################################
# multiprox — cluster lifecycle
#
# Targets
#   build          Build (or rebuild) the PVE node image
#   up             Start all nodes in the background
#   down           Stop and remove containers (volumes preserved)
#   clean          Stop + remove containers AND named volumes
#
#   cluster-init   Create the cluster on pve1 (run once after 'make up')
#   cluster-join   Join pve2 and pve3 to the cluster (run after cluster-init)
#   cluster-full   cluster-init + cluster-join in one shot
#
#   status         pvecm status via pve1
#   nodes          pvecm nodes via pve1
#
#   shell N=pve1   Open a bash shell on the given node
#   logs  N=pve1   Tail logs for a specific node (or all if N unset)
#   restart N=pve1 Restart a specific node
#
#   scale N=5      Generate and apply compose override for N nodes total
##############################################################################

COMPOSE  := docker compose
PROJECT  := multiprox

# Default node for shell/logs/restart targets
N ?= pve1

.PHONY: build up down clean \
        cluster-init cluster-join cluster-full \
        status nodes \
        shell logs restart \
        scale \
        help

# ── Image & containers ────────────────────────────────────────────────────────

build:
	$(COMPOSE) build

up:
	$(COMPOSE) up -d
	@echo ""
	@echo "  Nodes starting. Monitor with: make logs"
	@echo "  When healthy, run: make cluster-full"
	@echo ""
	@echo "  Web UI:"
	@echo "    pve1 → https://localhost:8006"
	@echo "    pve2 → https://localhost:8007"
	@echo "    pve3 → https://localhost:8008"

down:
	$(COMPOSE) down

clean:
	$(COMPOSE) down -v --remove-orphans
	@echo "Volumes removed. Run 'make build && make up' to start fresh."

# ── Cluster lifecycle ─────────────────────────────────────────────────────────

cluster-init:
	@echo "==> Initialising cluster on pve1..."
	$(COMPOSE) exec pve1 cluster-init

cluster-join:
	@echo "==> Joining pve2..."
	$(COMPOSE) exec pve2 cluster-join
	@echo "==> Joining pve3..."
	$(COMPOSE) exec pve3 cluster-join

cluster-full: cluster-init cluster-join
	@echo "==> Cluster fully formed. Status:"
	$(COMPOSE) exec pve1 pvecm status

# ── Ceph ──────────────────────────────────────────────────────────────────────
# Requires the ceph overlay and PVE*_OSD_DEVICE set in .env:
#   docker compose -f docker-compose.yml -f docker-compose.ceph.yml up -d
# See docker-compose.ceph.yml for the disk-selection warning.

COMPOSE_CEPH := docker compose -f docker-compose.yml -f docker-compose.ceph.yml

.PHONY: ceph-up ceph-init ceph-osd ceph-pool ceph-status ceph-full

ceph-up:
	$(COMPOSE_CEPH) up -d

# pveceph init + a mon/mgr on every node.
ceph-init:
	$(COMPOSE_CEPH) exec -T pve1 pveceph init --network $(CEPH_NETWORK)
	@for n in 1 2 3; do \
	  echo "==> mon/mgr on pve$$n"; \
	  $(COMPOSE_CEPH) exec -T pve$$n pveceph mon create || true; \
	done

# One OSD per node from the mapped device. ceph-osd-create resolves the mapped
# path to the kernel name Proxmox needs, and refuses mounted devices.
ceph-osd:
	@for n in 1 2 3; do \
	  echo "==> OSD on pve$$n"; \
	  $(COMPOSE_CEPH) exec -T pve$$n ceph-osd-create; \
	done

ceph-pool:
	$(COMPOSE_CEPH) exec -T pve1 pveceph pool create $(CEPH_POOL) \
	  --size 3 --min_size 2 --add_storages 1
	# PVE creates pools with pg_autoscale_mode=warn and a default pg_num of 128.
	# On a small cluster that is too many, so Ceph sits at HEALTH_WARN
	# ("POOL_TOO_MANY_PGS ... should have 32") and will not fix it itself.
	# Turning the autoscaler on lets it converge to the right count.
	$(COMPOSE_CEPH) exec -T pve1 ceph osd pool set $(CEPH_POOL) pg_autoscale_mode on

ceph-status:
	$(COMPOSE_CEPH) exec -T pve1 ceph -s
	@echo ""
	$(COMPOSE_CEPH) exec -T pve1 pvesm status

# Everything, assuming the PVE cluster is already formed.
ceph-full: ceph-init ceph-osd ceph-pool ceph-status

CEPH_NETWORK ?= 10.10.0.0/24
CEPH_POOL    ?= ceph-vm

# ── Cluster inspection ────────────────────────────────────────────────────────

status:
	$(COMPOSE) exec pve1 pvecm status

nodes:
	$(COMPOSE) exec pve1 pvecm nodes

# ── Node operations ───────────────────────────────────────────────────────────

shell:
	$(COMPOSE) exec $(N) bash

logs:
ifdef N
	$(COMPOSE) logs -f $(N)
else
	$(COMPOSE) logs -f
endif

restart:
	$(COMPOSE) restart $(N)

# ── Scale: generate compose override for N nodes ──────────────────────────────
# Usage: make scale N=6
# Generates docker-compose.scale.yml with nodes pve4 … pveN and
# applies it alongside the base compose file.
#
# NOTE: After scaling, join new nodes manually:
#   docker exec -it multiprox-pveX cluster-join

SCALE_FILE := docker-compose.scale.yml

scale:
	@if [ -z "$(N)" ] || [ "$(N)" -le 3 ]; then \
	    echo "Usage: make scale N=<number>  (must be > 3)"; exit 1; \
	fi
	@echo "# Auto-generated by 'make scale N=$(N)'" > $(SCALE_FILE)
	@echo "# Do not edit manually — regenerate with 'make scale N=$(N)'" >> $(SCALE_FILE)
	@echo "" >> $(SCALE_FILE)
	@echo "services:" >> $(SCALE_FILE)
	@for i in $$(seq 4 $(N)); do \
	    IP="10.10.0.$$(( 10 + i ))"; \
	    PORT_UI="$$(( 8005 + i ))"; \
	    PORT_SSH="$$(( 2220 + i ))"; \
	    echo "  pve$${i}:" >> $(SCALE_FILE); \
	    echo "    extends:" >> $(SCALE_FILE); \
	    echo "      file: docker-compose.yml" >> $(SCALE_FILE); \
	    echo "      service: pve3" >> $(SCALE_FILE); \
	    echo "    container_name: multiprox-pve$${i}" >> $(SCALE_FILE); \
	    echo "    hostname: pve$${i}.multiprox.local" >> $(SCALE_FILE); \
	    echo "    environment:" >> $(SCALE_FILE); \
	    echo "      NODE_NAME: pve$${i}" >> $(SCALE_FILE); \
	    echo "      NODE_IP:   $${IP}" >> $(SCALE_FILE); \
	    echo "      NODE_ID:   $${i}" >> $(SCALE_FILE); \
	    echo "    networks:" >> $(SCALE_FILE); \
	    echo "      proxmox-net:" >> $(SCALE_FILE); \
	    echo "        ipv4_address: $${IP}" >> $(SCALE_FILE); \
	    echo "    ports:" >> $(SCALE_FILE); \
	    echo "      - \"$${PORT_UI}:8006\"" >> $(SCALE_FILE); \
	    echo "      - \"$${PORT_SSH}:22\"" >> $(SCALE_FILE); \
	    echo "    volumes:" >> $(SCALE_FILE); \
	    echo "      - /sys/fs/cgroup:/sys/fs/cgroup:ro" >> $(SCALE_FILE); \
	    echo "      - pve$${i}-cluster:/var/lib/pve-cluster" >> $(SCALE_FILE); \
	    echo "      - pve$${i}-storage:/var/lib/vz" >> $(SCALE_FILE); \
	    echo "      - pve$${i}-logs:/var/log/pve" >> $(SCALE_FILE); \
	    echo "" >> $(SCALE_FILE); \
	done
	@echo "volumes:" >> $(SCALE_FILE)
	@for i in $$(seq 4 $(N)); do \
	    echo "  pve$${i}-cluster:" >> $(SCALE_FILE); \
	    echo "  pve$${i}-storage:" >> $(SCALE_FILE); \
	    echo "  pve$${i}-logs:" >> $(SCALE_FILE); \
	done
	@echo "Generated $(SCALE_FILE) for $(N) nodes."
	$(COMPOSE) -f docker-compose.yml -f $(SCALE_FILE) up -d

# ── Help ──────────────────────────────────────────────────────────────────────

help:
	@grep -E '^[a-zA-Z_-]+:' Makefile \
	    | grep -v '^\.PHONY' \
	    | awk -F: '{printf "  %-20s\n", $$1}'
