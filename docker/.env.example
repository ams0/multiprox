# multiprox — environment configuration
# Copy this file to .env and adjust as needed.
#
#   cp .env.example .env

# ── Cluster identity ──────────────────────────────────────────────────────────
CLUSTER_NAME=multiprox

# IP of the bootstrap node (pve1). Other nodes SSH here during pvecm join.
NODE1_IP=10.10.0.11

# Root password for all nodes.
# IMPORTANT: change this before exposing any port to an external network.
ROOT_PASSWORD=proxmox

# ── Host port mappings ────────────────────────────────────────────────────────
# PVE web UI (HTTPS)
PVE1_UI_PORT=8006
PVE2_UI_PORT=8007
PVE3_UI_PORT=8008

# SSH (for manual access; pvecm uses the internal Docker network directly)
PVE1_SSH_PORT=22201
PVE2_SSH_PORT=22202
PVE3_SSH_PORT=22203

# ── Ceph OSD devices (only for docker-compose.ceph.yml) ──────────────────────
# One dedicated, EMPTY disk per node. `pveceph osd create` destroys whatever is
# on the device it is given, without prompting.
#
# Use /dev/disk/by-id/... — kernel names like /dev/sdb are assigned in discovery
# order and shift across reboots. Identify yours with:
#   lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT
#   findmnt -no SOURCE /                  # never point at this disk
#   ls -l /dev/disk/by-id/ | grep -v part
#
# PVE1_OSD_DEVICE=/dev/disk/by-id/scsi-xxxxaaa
# PVE2_OSD_DEVICE=/dev/disk/by-id/scsi-xxxxbbb
# PVE3_OSD_DEVICE=/dev/disk/by-id/scsi-xxxxccc
