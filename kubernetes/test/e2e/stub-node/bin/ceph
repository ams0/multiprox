#!/bin/bash
# Stub ceph — E2E only.
#
# Deliberately minimal. The e2e environment (kind + local-path) cannot provide
# raw block volumes, so no OSD devices exist and a real Ceph cluster can never
# form here. Simulating a *healthy* Ceph would be a lie that hides exactly the
# failure the Ceph tests are meant to observe.
#
# So this reports "not initialized / unreachable" honestly. The operator's
# cluster-inventory.sh and ceph-status.sh both guard on these exact signals,
# and the tests assert the operator surfaces the problem rather than claiming
# success.

set -uo pipefail

# Without ceph.conf there is no cluster; the real scripts treat this as fatal
# and skip all Ceph collection.
if [ ! -f /etc/pve/ceph.conf ]; then
  exit 1
fi

case "${1:-} ${2:-}" in
  "health "*|"health")
    echo "HEALTH_WARN no OSDs configured (e2e stub: no raw block devices available)"
    exit 0
    ;;
  "osd stat")
    echo '{"num_osds":0,"num_up_osds":0,"num_in_osds":0}'
    exit 0
    ;;
  "osd tree")
    echo "ID  CLASS  WEIGHT  TYPE NAME"
    echo "-1         0       root default"
    exit 0
    ;;
  "osd pool"*)
    exit 0
    ;;
  "mon dump")
    echo "epoch 0"
    exit 0
    ;;
  "mgr dump")
    echo '{}'
    exit 0
    ;;
  "-s"*|"status"*)
    # No mon has been created, so the cluster is unreachable.
    exit 1
    ;;
esac

exit 1
