#!/bin/bash
# Fake init for the e2e stub node — stands in for /lib/systemd/systemd.
#
# node-bootstrap.sh (generated by the operator, run verbatim) ends with
#   exec /lib/systemd/systemd --system --unit=multi-user.target
# so this process is what keeps the pod alive.
#
# It starts a REAL sshd, because the operator's cluster-join.sh waits for TCP
# :22 before invoking pvecm add — mirroring how a genuine pvecm add exchanges
# cluster credentials over SSH.
#
# Deliberately a real sshd and not a netcat listener. The stub used to install
# netcat, which the real Proxmox image does not have, and that difference hid a
# real bug: the generated cluster-join.sh used `nc -z`, which failed with
# command-not-found on every real node while passing in e2e. A stub must never
# be more capable than the image it substitutes for.

set -u

log() { echo "[fake-init/$(hostname -s 2>/dev/null || hostname)] $*"; }

# sshd needs its privilege-separation directory and host keys. node-bootstrap.sh
# normally runs ssh-keygen -A already; repeat it here so this works standalone.
mkdir -p /run/sshd
[ -f /etc/ssh/ssh_host_ed25519_key ] || ssh-keygen -A >/dev/null 2>&1

if /usr/sbin/sshd 2>/dev/null; then
    log "sshd started on :22"
else
    log "WARNING: sshd failed to start; cluster-join will not be exercisable"
fi

trap 'exit 0' TERM INT

log "stub node up; sleeping as PID 1 stand-in"
while true; do
    sleep 3600 &
    wait $!
done
